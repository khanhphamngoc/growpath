# ─── AI Provider ───────────────────────────────────────────────────────────────
# Override provider explicitly. If unset: "ollama" in development, "anthropic" in production.
# AI_PROVIDER=ollama

# Anthropic (production)
ANTHROPIC_API_KEY=

# Ollama (local dev) — defaults shown, only set if you change them
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_SYNTHESIS_MODEL=qwen3.5:9b
# OLLAMA_NUDGE_MODEL=llama3.2:3b

# ─── Auth ───────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://growpath:growpath@localhost:5432/growpath

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
